{
  "cleanUrls": true,
  "redirects": [
    { "source": "/tx", "destination": "/kimochi", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/rx", "destination": "/rx.html" },
    { "source": "/kimochi", "destination": "/kimochi.html" },
    { "source": "/split", "destination": "/split.html" }
  ]
}
